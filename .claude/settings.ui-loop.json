{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Task",
      "Edit(moralstack/ui/**)",
      "Write(moralstack/ui/**)",
      "Edit(tests/test_ui_*.py)",
      "Write(tests/test_ui_*.py)",
      "Edit(CHANGELOG.md)",
      "Edit(.claude/ui-loop/**)",
      "Write(.claude/ui-loop/**)",
      "Bash(python .claude/skills/improve-moralstack-ui/scripts/state.py:*)",
      "Bash(python .claude/skills/improve-moralstack-ui/scripts/preflight.py:*)",
      "Bash(python .claude/skills/improve-moralstack-ui/scripts/ui_login.py:*)",
      "Bash(python .claude/skills/improve-moralstack-ui/scripts/scenarios.py:*)",
      "Bash(python .claude/skills/improve-moralstack-ui/scripts/verify.py:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(python -m black:*)",
      "Bash(python -m mypy:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(rg:*)",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Bash(cat .env)",
      "Bash(type .env)",
      "Edit(moralstack/runtime/**)",
      "Edit(moralstack/orchestration/**)",
      "Edit(moralstack/constitution/**)",
      "Edit(moralstack/observability/**)",
      "Edit(moralstack/compliance/**)",
      "Edit(moralstack/server/**)",
      "Edit(moralstack/prompts/**)",
      "Edit(moralstack/models/**)",
      "Edit(moralstack/core/**)",
      "Edit(moralstack/persistence/**)",
      "Edit(pyproject.toml)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(scripts/**)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
