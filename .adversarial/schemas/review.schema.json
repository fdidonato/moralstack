{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdversarialReview",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "REVISE",
        "REJECT"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "baseline_usage": {
      "type": "object",
      "properties": {
        "used_baseline": {
          "type": "boolean"
        },
        "missing_relevant_documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradicted_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "used_baseline",
        "missing_relevant_documents",
        "contradicted_invariants"
      ],
      "additionalProperties": false
    },
    "drift_handling": {
      "type": "object",
      "properties": {
        "drift_report_considered": {
          "type": "boolean"
        },
        "unresolved_doc_code_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "drift_report_considered",
        "unresolved_doc_code_conflicts"
      ],
      "additionalProperties": false
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Evidence source category, for example DOC, CODE, TEST, DRIFT, or ASSUMPTION."
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Repository file path when available; null when the issue is not tied to a specific file."
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Function, class, method, config key, or symbol when available; null when not applicable."
                },
                "reason": {
                  "type": "string",
                  "description": "Why this evidence supports the issue."
                }
              },
              "required": [
                "source",
                "file",
                "symbol",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required_fix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "claim",
          "evidence",
          "required_fix"
        ],
        "additionalProperties": false
      }
    },
    "missing_investigations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unsafe_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documentation_update_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_blocking_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "confidence",
    "baseline_usage",
    "drift_handling",
    "blocking_issues",
    "missing_investigations",
    "unsafe_assumptions",
    "test_gaps",
    "documentation_update_gaps",
    "non_blocking_warnings",
    "summary"
  ],
  "additionalProperties": false
}
