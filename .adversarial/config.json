{
  "version": 1,
  "mode": "documentation-grounded-dual-adversarial-planning",
  "models": {
    "claude_planner": "claude-opus-4-7",
    "claude_reviewer": "claude-opus-4-7",
    "claude_synthesizer": "claude-opus-4-7",
    "codex_planner": "gpt-5.5",
    "codex_reviewer": "gpt-5.3-codex",
    "codex_final_gate": "gpt-5.3-codex"
  },
  "limits": {
    "max_review_rounds": 1,
    "min_final_confidence": 0.82,
    "max_digest_chars_per_document": 18000,
    "max_context_grep_matches": 250,
    "max_command_seconds": 900
  },
  "safety": {
    "planning_only": true,
    "codex_sandbox": "read-only",
    "claude_permission_mode": "plan",
    "disallowed_claude_tools": [
      "Edit",
      "MultiEdit",
      "Write",
      "NotebookEdit"
    ]
  },
  "commands": {
    "claude_binary": "claude",
    "codex_binary": "codex",
    "claude_prompt_mode": "stdin",
    "codex_prompt_mode": "stdin",
    "codex_output_flag": "-o",
    "codex_schema_flag": "--output-schema",
    "codex_model_flag": "--model"
  },
  "context_pack": {
    "include_git_status": true,
    "include_recent_commits": 20,
    "include_file_tree": true,
    "include_project_markers": true,
    "include_tests_inventory": true,
    "include_task_search_terms": true,
    "task_keyword_limit": 18,
    "moralstack_extra_searches": true
  },
  "output": {
    "runs_dir": ".adversarial/runs",
    "keep_raw_prompts": true,
    "generate_markdown_report": true,
    "copy_baseline_snapshot": true
  }
}
