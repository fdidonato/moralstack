{
  "baseline": {
    "name": "moralstack-adversarial-documentation",
    "version": 1,
    "description": "Trusted adversarial documentation baseline used by the dual-planning workflow. This corrected default only declares the documentation that was actually produced: CLAUDE.md, docs/MORALSTACK_CODEBASE_INDEX.md and docs/CODEBASE_FACTS.md. Add further documents manually only after they exist."
  },
  "required_documents": [
    {
      "path": "CLAUDE.md",
      "role": "agent_operating_rules",
      "authority": "high",
      "required": true,
      "always_include": true
    },
    {
      "path": "docs/MORALSTACK_CODEBASE_INDEX.md",
      "role": "codebase_index",
      "authority": "high",
      "required": true,
      "always_include": true
    },
    {
      "path": "docs/CODEBASE_FACTS.md",
      "role": "verified_facts",
      "authority": "high",
      "required": true,
      "always_include": true
    }
  ],
  "trace_directories": [
    {
      "path": "docs/traces",
      "role": "validated_trace_documents_if_present",
      "authority": "medium",
      "required": false
    }
  ],
  "trust_policy": {
    "documentation_is_primary_for_architectural_intent": true,
    "code_is_primary_for_current_runtime_behavior": true,
    "unresolved_doc_code_conflict_blocks_final_plan": true,
    "final_plan_must_reference_baseline": true,
    "final_plan_must_include_documentation_updates": true
  }
}
