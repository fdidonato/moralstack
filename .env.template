MORALSTACK_UI_USERNAME=admin

# Basic Auth password (required when running moralstack-ui).
MORALSTACK_UI_PASSWORD=admin

# -----------------------------------------------------------------------------
# Benchmark (scripts/benchmark_moralstack.py) and benchmark reports
# -----------------------------------------------------------------------------
# Tool settings: read by scripts/benchmark_moralstack.py (and, for the outputs dir, by moralstack-ui).
# scripts/verify_prompt_audit.py reads no environment variable (--db / --run-id are CLI flags).

# Directory of benchmark_{run_id}.json reports loaded by moralstack-ui (relative = project root).
# Type: path.
# The benchmark script never uses it: --outdir defaults to 'benchmark_outputs'
# (benchmark_moralstack.py:4066-4068), so the 'or os.getenv(...)' at :4127 is unreachable unless
# --outdir '' is passed.
MORALSTACK_BENCHMARK_OUTPUTS=benchmark_outputs

# Baseline model (raw model, no MoralStack).
# Type: model id. Default: follows --model (default gpt-4o) (= gpt-4o).
# WARNING: when set, this takes precedence over the --model CLI flag (baseline arm only). Left
# commented so that setting stays in control; the value shown is the shipped value.
# MORALSTACK_BENCHMARK_BASELINE_MODEL=gpt-4o

# Judge model.
# Type: model id. (code default: follows --judge-model, else --model (default gpt-4o) = gpt-4o)
# WARNING: when set, this takes precedence over the --judge-model CLI flag. Set on purpose: the
# benchmark runs are judged by this model; comment it out to choose the judge with --judge-model.
MORALSTACK_BENCHMARK_JUDGE_MODEL=gpt-5.2

# -----------------------------------------------------------------------------
# Examples (examples/server_quickstart.py)
# -----------------------------------------------------------------------------
# Read only by the example launcher, not by the moralstack package.

# Host of the example proxy launcher. Not read by the moralstack package.
# Type: host.
# examples only: examples/server_quickstart.py (not read by the moralstack package).
MORALSTACK_OPENAI_COMPATIBLE_API_HOST=localhost

# Port of the example proxy launcher. Not read by the moralstack package.
# Type: int.
# examples only: examples/server_quickstart.py (not read by the moralstack package).
MORALSTACK_OPENAI_COMPATIBLE_API_PORT=8787

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------

# Print file-removal errors during --clean-start. ANY non-empty value enables it (even 0 or false):
# comment the line out to turn it off.
# Type: flag. (code default: unset = off)
MORALSTACK_VERBOSE=1

# Temporary Phase 0 token/latency timers.
# Type: bool (1|true|yes|on = on).
MORALSTACK_PHASE0_TIMING=0

# Optional JSONL file for Phase 0 timing records (only with MORALSTACK_PHASE0_TIMING on).
# Type: path. No default: leave commented unless needed.
# MORALSTACK_PHASE0_TIMING_JSONL=logs/phase0_timing.jsonl

