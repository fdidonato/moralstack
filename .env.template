# -----------------------------------------------------------------------------
# Orchestrator
# -----------------------------------------------------------------------------
# See docs/modules/orchestrator.md. Cycle-1 early convergence (the CYCLE1_* thresholds) lets a
# DELIBERATIVE_PATH query stop after cycle 1 when all modules agree (only with max cycles >= 2):
# lower values = more early convergence, higher = more conservative.

# Max deliberation cycles.
# Type: int >= 1.
MORALSTACK_ORCHESTRATOR_MAX_DELIBERATION_CYCLES=2

# Risk score below which a request is low risk.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_RISK_LOW_THRESHOLD=0.3

# Risk score below which a request is medium risk.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_RISK_MEDIUM_THRESHOLD=0.7

# Orchestration timeout budget.
# Type: int >= 1 (ms).
MORALSTACK_ORCHESTRATOR_TIMEOUT_MS=600000

# Run the perspective ensemble.
# Type: bool.
MORALSTACK_ORCHESTRATOR_ENABLE_PERSPECTIVES=true

# Scenarios requested from the simulator per cycle.
# Type: int >= 1.
MORALSTACK_ORCHESTRATOR_NUM_SIMULATIONS=3

# Minimum hindsight score for convergence.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_MIN_HINDSIGHT_SCORE=0.8

# Tolerated critical violations.
# Type: int >= 0.
# DEPRECATED - no effect, removal in 2.0 (OrchestratorConfig.max_critical_violations has no consumer).
# MORALSTACK_ORCHESTRATOR_MAX_CRITICAL_VIOLATIONS=0

# Hindsight early-exit threshold.
# Type: float [0,1]. (code default: 0.6)
# DEPRECATED - no effect, removal in 2.0 (OrchestratorConfig.early_exit_hindsight_threshold has no consumer).
# MORALSTACK_ORCHESTRATOR_EARLY_EXIT_HINDSIGHT_THRESHOLD=0.6

# Run the consequence simulator.
# Type: bool.
MORALSTACK_ORCHESTRATOR_ENABLE_SIMULATION=true

# Run the hindsight evaluator.
# Type: bool.
MORALSTACK_ORCHESTRATOR_ENABLE_HINDSIGHT=true

# DEPRECATED - no effect, removal in 2.0 (F6, PROJECT_SPEC 5.7).
# Type: bool.
# NO EFFECT: pipeline errors always deliver a fixed governed refusal; false only logs a WARNING
# (config_loader.py).
# MORALSTACK_ORCHESTRATOR_SAFE_RESPONSE_ON_ERROR=true

# Fraction of the timeout after which optional modules are skipped.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_SKIP_OPTIONAL_MODULES_THRESHOLD=0.95

# Fraction of the timeout after which a timeout warning is recorded.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_SOFT_TIMEOUT_THRESHOLD=0.90

# Run critic/simulator/perspectives in parallel (calls persisted and visible in moralstack-ui).
# Type: bool.
MORALSTACK_ORCHESTRATOR_PARALLEL_MODULE_CALLS=true

# Skip the simulator when the gate conditions below hold.
# Type: bool. (code default: false)
MORALSTACK_ORCHESTRATOR_ENABLE_SIMULATOR_GATING=true

# true: hindsight only in the final cycle; false: every cycle.
# Type: bool.
MORALSTACK_ORCHESTRATOR_ENABLE_HINDSIGHT_GATING=true

# Simulator gate: semantic-harm threshold.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_SIMULATOR_GATE_SEMANTIC_HARM_THRESHOLD=0.4

# Simulator gate: draft delta (chars) threshold.
# Type: int >= 0.
MORALSTACK_ORCHESTRATOR_SIMULATOR_GATE_DELTA_CHARS_THRESHOLD=100

# Conservative skip only if prior semantic_expected_harm is strictly below this.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_SIMULATOR_GATE_SKIP_MAX_PRIOR_SEMANTIC_HARM=0.25

# Cycle-1 early convergence: min weighted approval.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_CYCLE1_EARLY_CONVERGENCE_MIN_WEIGHTED_APPROVAL=0.78

# Cycle-1 early convergence: max semantic harm.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_CYCLE1_EARLY_CONVERGENCE_MAX_SEMANTIC_HARM=0.35

# Cycle-1 early convergence: min per-perspective approval.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_CYCLE1_EARLY_CONVERGENCE_MIN_PER_PERSPECTIVE_APPROVAL=0.70

# Upper boundary of the borderline-refuse zone.
# Type: float [0,1].
MORALSTACK_ORCHESTRATOR_BORDERLINE_REFUSE_UPPER=0.95

# With PARALLEL_MODULE_CALLS=true, run the critic in parallel with simulator+perspectives instead of
# gating them; hard violations are still honoured.
# Type: bool.
MORALSTACK_ORCHESTRATOR_PARALLEL_CRITIC_WITH_MODULES=true

# Each cycle picks critic_gated vs full_parallel from risk posture (execution only); false = static
# fork only.
# Type: bool.
MORALSTACK_ORCHESTRATOR_ENABLE_DYNAMIC_PARALLEL_SCHEDULER=true

# Overlap risk estimation and draft generation.
# Type: bool.
MORALSTACK_ORCHESTRATOR_ENABLE_SPECULATIVE_GENERATION=true

# Opt-in: a clearly benign, non-operational informational request in a sensitive overlay returns
# NORMAL_COMPLETE instead of being floored to SAFE_COMPLETE; any risk signal keeps SAFE_COMPLETE.
# Type: bool. (code default: false)
MORALSTACK_ORCHESTRATOR_REGULATED_INFORMATIONAL_NORMAL_COMPLETE=true

# -----------------------------------------------------------------------------
# Developer Contract Compliance Layer (DCCL)
# -----------------------------------------------------------------------------
# Requests carrying a developer contract are evaluated by the DCCL before the standard pipeline.

# Enable the DCCL (contracts evaluated before the standard pipeline).
# Type: bool.
MORALSTACK_DCCL_ENABLED=true

# structured = structured_rules only; llm = raw_text via LLM only; hybrid = structured first, LLM
# fallback.
# Values: structured | llm | hybrid.
MORALSTACK_DCCL_EVALUATION_PATH=hybrid

# Model of the DCCL LLM path (gpt-4o-mini is cheaper, less reliable on adversarial contracts).
# Type: model id.
MORALSTACK_DCCL_LLM_MODEL=gpt-4o

# Model of the language-agnostic safety-override classifier (runs on every MATCH; keep it small).
# Type: model id.
MORALSTACK_DCCL_SAFETY_OVERRIDE_MODEL=gpt-4o-mini

# LLM-path timeout; on timeout the DCCL returns NO_MATCH (failsafe to the standard pipeline).
# Type: int >= 100 (ms).
MORALSTACK_DCCL_LLM_TIMEOUT_MS=5000

# LLM-path max output tokens.
# Type: int >= 64.
MORALSTACK_DCCL_LLM_MAX_TOKENS=512

# Min confidence for a MATCH verdict; higher = more conservative.
# Type: float [0,1].
MORALSTACK_DCCL_CONFIDENCE_THRESHOLD=0.85

# Max structured_rules per contract; larger contracts fail to load.
# Type: int >= 1.
MORALSTACK_DCCL_MAX_RULES_PER_CONTRACT=100

# true: safety-restricted rules are rejected at contract load and SAFETY_OVERRIDE is emitted at
# runtime; false: runtime check only.
# Type: bool.
MORALSTACK_DCCL_SAFETY_OVERRIDE_STRICT=true

