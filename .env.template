# See docs/modules/hindsight.md.

# Hindsight evaluator model.
# Type: model id. (code default: follows primary model (OPENAI_MODEL) = gpt-4o)
MORALSTACK_HINDSIGHT_MODEL=gpt-4o-mini

# Hindsight attempts per call.
# Type: int >= 1.
MORALSTACK_HINDSIGHT_MAX_RETRIES=3

# Hindsight max output tokens.
# Type: int >= 1.
MORALSTACK_HINDSIGHT_MAX_TOKENS=768

# Hindsight temperature.
# Type: float [0,2]. (code default: 0.3)
MORALSTACK_HINDSIGHT_TEMPERATURE=0.2

# Hindsight top_p.
# Type: float [0,1].
MORALSTACK_HINDSIGHT_TOP_P=0.9

# Weight of safety in the hindsight score.
# Type: float [0,1].
MORALSTACK_HINDSIGHT_WEIGHT_SAFETY=0.5

# Weight of helpfulness in the hindsight score.
# Type: float [0,1].
MORALSTACK_HINDSIGHT_WEIGHT_HELPFULNESS=0.3

# Weight of honesty in the hindsight score.
