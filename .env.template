# MoralStack Configuration
# Copy this file to .env and set your values.
# Non-empty values in .env ALWAYS override pre-existing environment variables.
#
# Every variable the program reads is listed here with an EXPLICIT value: the tuned value MoralStack
# ships. Where it differs from the built-in code default, the comment says "(code default: X)";
# commenting such a line out reverts that variable to its code default.
#
# Variables WITHOUT a default (secrets, URLs, paths, opt-in features) stay COMMENTED OUT (with #):
# setting them to an empty value (e.g. OPENAI_BASE_URL=) injects an empty string into the
# environment, which can break third-party libraries that read env vars directly. Uncomment and
# fill them only when you need them.
#
# - "Default: follows X" marks a value that, when unset, inherits X. Written out here it no longer
#   follows X: if you change X (e.g. OPENAI_MODEL), change the dependent values too, or comment them.
# - Variables that take precedence over a GovernanceConfig field or a CLI flag are COMMENTED, with
#   a WARNING naming that field or flag: uncomment them only to pin the value for every caller.

# -----------------------------------------------------------------------------
# OpenAI / governed answer model
# -----------------------------------------------------------------------------
# Required for real runs.

# OpenAI API key (required for real runs). Also read directly by the openai library.
OPENAI_API_KEY=

# Governed answer model (first-pass / speculative / compliance generation) and the primary model
# every module inherits. Precedence: GovernanceConfig.model / CLI --openai-model > this variable >
# gpt-4o.
# Type: model id.
# scripts/benchmark_moralstack.py ignores it: the benchmark policy model is --model (default
# gpt-4o).
OPENAI_MODEL=gpt-4o

# Model for governed revisions (policy.rewrite(), cycle 2+).
# Type: model id. Default: follows primary model (OPENAI_MODEL) (= gpt-4o).
# A revised answer is still delivered to the user, so by default it comes from the primary model.
# Set a lighter model id (e.g. gpt-4.1-nano) to reduce revision latency, accepting that those
# answers are written by a smaller model.
MORALSTACK_POLICY_REWRITE_MODEL=gpt-4o

# Custom OpenAI-compatible endpoint (proxy / enterprise gateway). Unset = official OpenAI endpoint.
# Precedence in the SDK: GovernanceConfig.base_url > this variable.
# Type: URL. No default: leave commented unless needed.
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# Per-call timeout of the policy client and of the upstream speculative draft, in milliseconds.
# Type: int (ms).
OPENAI_TIMEOUT_MS=60000

# Policy-client retries on transient provider errors.
# Type: int.
OPENAI_MAX_RETRIES=3

# Default sampling temperature of the governed answer (generate / rewrite / speculative draft).
# Type: float. (code default: 0.7)
OPENAI_TEMPERATURE=1

# Default nucleus-sampling top_p of the governed answer.
# Type: float [0,1]. (code default: 0.9)
OPENAI_TOP_P=1

# Max output tokens for the delivered answer (generate / rewrite / speculative draft).
# Type: int.
# Must not be left empty: it is not in the load_env purge list and int('') fails at startup.
# A client may override max_tokens / max_completion_tokens / temperature / top_p per request via
# the API. NOTE: on the proxy a sampling parameter the client does NOT send is omitted from the
# OpenAI call (the model uses its own default), so on the proxy path these env defaults apply only
# to the REFUSE wording.
OPENAI_MAX_TOKENS=4096

# Speculative-draft generation mode (SDK wrapper and proxy only). upstream_then_verify lets the
# caller's client write the speculative draft, which is then validated like an internal draft;
# unknown values resolve to internal (fail closed).
# Values: internal | upstream_then_verify. Default: internal.
# WARNING: when set, this takes precedence over GovernanceConfig.generation. Left commented so that
# setting stays in control; the value shown is the shipped value.
# MORALSTACK_GENERATION_MODE=internal

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Path to the SQLite database. Setting it enables DB persistence (the dashboard and
# scripts/verify_prompt_audit.py read it). Comment the line out to disable DB persistence.
# Type: path. (code default: unset = no DB)
MORALSTACK_OBSERVABILITY_DB_PATH=moralstack.db

# Where telemetry goes. Set explicitly together with the DB path above; if you comment the DB path
# out, change this to file_only (or comment it out: the code then derives db_only when a DB path is
# set, else file_only).
# Values: db_only | dual | file_only. (code default: db_only if a DB path is set, else file_only)
MORALSTACK_OBSERVABILITY_MODE=db_only

# JSONL output directory (file_only and dual modes).
# Type: path.
MORALSTACK_OBSERVABILITY_JSONL_DIR=logs/observability

# Max envelopes the observability writer flushes in one SQLite batch.
# Type: int >= 1.
MORALSTACK_OBSERVABILITY_BATCH_MAX_ITEMS=500

# Max time the observability writer waits to fill a batch before flushing.
# Type: int >= 1 (ms).
MORALSTACK_OBSERVABILITY_BATCH_MAX_DELAY_MS=50

# Decision-trace JSONL file appended by the orchestration (relative to the current working
# directory).
# Type: path.
MORALSTACK_DECISION_TRACE_PATH=logs/decision_trace.jsonl

# -----------------------------------------------------------------------------
# Prompt overrides
# -----------------------------------------------------------------------------

# Directory of *.yaml prompt overrides (format: docs/prompt_overrides.md). Unset = packaged
# defaults.
# Type: path. No default: leave commented unless needed.
# Precedence: GovernanceConfig.prompts_dir, then this variable, then the packaged defaults.
# A missing or empty directory stops startup.
# WARNING: overrides can WEAKEN governance, including the prompts that make the models report hard
# signals (self-harm, child safety, weapons, physical harm). Every override is audited and logged:
# one WARNING per overridden safety-relevant fragment, a generic WARNING for any other override plus
# an INFO count, and a specific WARNING if the anti-leak canary is disabled. Never blocked.
# Override texts are stored verbatim in the run audit: never put secrets in a prompt.
# MORALSTACK_PROMPTS_DIR=/path/to/prompt-overrides

# -----------------------------------------------------------------------------
# Constitution retrieval
# -----------------------------------------------------------------------------

# Max parallel domain agents in constitution retrieval (SDK / CLI). CLI --max-parallel-agents wins.
# Type: int >= 1.
# scripts/benchmark_moralstack.py does not read it (ConstitutionStore default 4).
MORALSTACK_CONSTITUTION_MAX_PARALLEL_AGENTS=4

# -----------------------------------------------------------------------------
# Risk Estimator
# -----------------------------------------------------------------------------
# See docs/modules/risk_estimator.md. Risk estimation always uses the three focused parallel
# mini-estimators; each model slot inherits MORALSTACK_RISK_MODEL, which inherits the primary model.

# Main risk-policy model; the three mini-estimator slots below inherit it.
# Type: model id. Default: follows primary model (OPENAI_MODEL) (= gpt-4o).
MORALSTACK_RISK_MODEL=gpt-4o

# Model of the intent mini-estimator.
# Type: model id. Default: follows MORALSTACK_RISK_MODEL (= gpt-4o).
MORALSTACK_RISK_INTENT_MODEL=gpt-4o

# Model of the signals mini-estimator.
# Type: model id. Default: follows MORALSTACK_RISK_MODEL (= gpt-4o).
MORALSTACK_RISK_SIGNALS_MODEL=gpt-4o

# Model of the operational mini-estimator.
# Type: model id. Default: follows MORALSTACK_RISK_MODEL (= gpt-4o).
MORALSTACK_RISK_OPERATIONAL_MODEL=gpt-4o

# Attempts per mini-estimator call.
# Type: int >= 1.
MORALSTACK_RISK_MAX_RETRIES=2

# Max output tokens per mini-estimator call.
# Type: int >= 1.
MORALSTACK_RISK_MAX_TOKENS=512

# Mini-estimator temperature.
# Type: float [0,2]. (code default: 0.1)
MORALSTACK_RISK_TEMPERATURE=0

# Mini-estimator top_p.
# Type: float [0,1]. (code default: 0.9)
MORALSTACK_RISK_TOP_P=0.8

# Constitution principles retrieved for risk estimation (when the controller passes no unified
# top_k).
# Type: int >= 1.
MORALSTACK_RISK_TOP_K=10

# Chars of each principle rule shown to the risk estimator.
# Type: int >= 1.
MORALSTACK_RISK_RULE_PREVIEW_LEN=200

# Lower bound of the crisis-score clamp.
# Type: float [0,1].
MORALSTACK_RISK_CRISIS_CLAMP_LOW=0.35

# Upper bound of the crisis-score clamp.
# Type: float [0,1].
MORALSTACK_RISK_CRISIS_CLAMP_HIGH=0.65

# -----------------------------------------------------------------------------
# Critic
# -----------------------------------------------------------------------------
# See docs/modules/critic.md.

# Constitutional critic model.
# Type: model id. Default: follows primary model (OPENAI_MODEL) (= gpt-4o).
MORALSTACK_CRITIC_MODEL=gpt-4o

# Critic attempts per call.
# Type: int >= 1.
MORALSTACK_CRITIC_MAX_RETRIES=2

# Critic max output tokens.
# Type: int >= 1. (code default: 384)
MORALSTACK_CRITIC_MAX_TOKENS=512

# Critic temperature.
# Type: float [0,2]. (code default: 0.1)
MORALSTACK_CRITIC_TEMPERATURE=0

# Critic top_p.
# Type: float [0,1].
MORALSTACK_CRITIC_TOP_P=0.9

# Principles retrieved for the critic.
# Type: int >= 1. (code default: 20)
MORALSTACK_CRITIC_TOP_K_PRINCIPLES=15

# Chars of each principle rule the critic reads.
# Type: int >= 1.
# Rules longer than this are cut mid-sentence: a carve-out placed at the end of a rule never reaches
# the judge. Longest rule shipped is 492 chars, so 512 disables truncation entirely at no extra cost
# (the window only caps, it does not pad). Set 180 to restore the historical window.
MORALSTACK_CRITIC_MAX_RULE_LEN=512

# -----------------------------------------------------------------------------
# Conversation window for the judging modules
# -----------------------------------------------------------------------------
# Last N turns, each cut to M chars, shown to the JUDGING modules (critic, simulator, hindsight).
# The generation path is NOT affected: the delivered answer is always written with the full history.
# Raising this is a measurable experiment, not a free win: a counterfactual on the critic showed the
# wider window does NOT change hard-violation verdicts (6/6 either way); it improves the stated
# rationale. Removing the truncation entirely costs ~$0.9 per COMPL-AI campaign.
# The cache fingerprint reads the same values (moralstack/utils/history_window.py): they must never
# be set apart, or two conversations differing only past the cut collide on one cache entry.

# Chars kept per history turn in the judging modules' view.
# Type: int >= 1. (code default: 200)
MORALSTACK_HISTORY_MAX_CHARS_PER_TURN=1500

# Trailing history turns shown to the judging modules.
# Type: int >= 1.
MORALSTACK_HISTORY_MAX_TURNS=3

# -----------------------------------------------------------------------------
# Simulator
# -----------------------------------------------------------------------------
# See docs/modules/simulator.md.

# Consequence simulator model.
# Type: model id. Default: follows primary model (OPENAI_MODEL) (= gpt-4o).
MORALSTACK_SIMULATOR_MODEL=gpt-4o

# Simulator attempts per call.
# Type: int >= 1.
MORALSTACK_SIMULATOR_MAX_RETRIES=3

# Simulator max output tokens.
# Type: int >= 1.
MORALSTACK_SIMULATOR_MAX_TOKENS=384

# Simulator temperature.
# Type: float [0,2]. (code default: 0.8)
MORALSTACK_SIMULATOR_TEMPERATURE=0.1

# Simulator top_p.
# Type: float [0,1].
MORALSTACK_SIMULATOR_TOP_P=0.95

# Scenarios simulated when the caller passes none.
# Type: int >= 1.
# Effectively inert in the governed pipeline: the only pipeline call passes
# MORALSTACK_ORCHESTRATOR_NUM_SIMULATIONS explicitly (deliberation_runner.py:4178-4181).
MORALSTACK_SIMULATOR_DEFAULT_NUM_SCENARIOS=3

# Use separate seeds per scenario.
# Type: bool.
MORALSTACK_SIMULATOR_USE_SEEDED_GENERATION=false

# Simulator result cache.
# Type: bool.
MORALSTACK_SIMULATOR_ENABLE_CACHING=true

