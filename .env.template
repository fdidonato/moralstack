MORALSTACK_PERSPECTIVES_TOP_P=0.9

# Evaluate the perspectives in parallel.
# Type: bool. (code default: true)
MORALSTACK_PERSPECTIVES_PARALLEL_EVALUATION=false

# Thread-pool size for parallel evaluation.
