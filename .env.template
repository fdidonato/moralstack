# MoralStack Configuration
# Copy this file to .env and set your values.
# Non-empty values in .env ALWAYS override pre-existing environment variables.
#
# IMPORTANT: Leave optional variables COMMENTED OUT (with #) if you don't need
# to override them. Setting a variable to empty (e.g. OPENAI_BASE_URL=) will
# inject an empty string into the environment, which can break third-party
# libraries that read env vars directly.

# -----------------------------------------------------------------------------
# OpenAI (required for real runs)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Model used for policy rewrite operations (cycle 2+).
# Uses a lighter model by default to reduce latency on revisions
# triggered by soft violations. Set to same value as OPENAI_MODEL
# to disable the downgrade.
MORALSTACK_POLICY_REWRITE_MODEL=gpt-4.1-nano
# OPENAI_BASE_URL=https://your-proxy.example.com/v1
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=3
OPENAI_TEMPERATURE=0.1
OPENAI_TOP_P=0.8
# Max output tokens for the delivered answer (generate / rewrite / speculative draft).
# Default 4096 (aligned with COMPL-AI requests). Used by the SDK/CLI paths.
# A client may override max_tokens / max_completion_tokens / temperature / top_p
# per request via the API. NOTE: on the proxy a sampling parameter the client does
# NOT send is omitted from the OpenAI call (the model uses its own default), so on
# the proxy path these env defaults apply only to the REFUSE wording.
OPENAI_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Path to SQLite database (enables persistence when set)
# MORALSTACK_OBSERVABILITY_DB_PATH=moralstack.db
# Mode: db_only | dual | file_only (default: db_only if DB_PATH set, else file_only)
# MORALSTACK_OBSERVABILITY_MODE=db_only
# JSONL output directory (file_only and dual modes; default: logs/observability)
# MORALSTACK_OBSERVABILITY_JSONL_DIR=logs/observability
#
# Semantic Decision Ledger (SDK / proxy bootstrap; Step 14.2)
# MORALSTACK_LEDGER_ENABLED=true
# MORALSTACK_LEDGER_SIMILARITY_THRESHOLD=0.92
# MORALSTACK_LEDGER_MAX_ENTRIES=1000
# MORALSTACK_LEDGER_EMBEDDING_MODEL=text-embedding-3-small
#
# Deprecated aliases (still work; emit a deprecation warning at runtime):
# MORALSTACK_DB_PATH=moralstack.db
# MORALSTACK_PERSIST_MODE=db_only

# -----------------------------------------------------------------------------
# Benchmark
# -----------------------------------------------------------------------------
# Directory for benchmark report files (benchmark_{run_id}.json). Used by benchmark
# script for persistence and by moralstack-ui for loading benchmark run details.
# Default: benchmark_outputs
# Relative paths are resolved against the project root (parent of moralstack package).
# MORALSTACK_BENCHMARK_OUTPUTS=benchmark_outputs
# Model for baseline (raw GPT, no MoralStack) only. Single source of truth for baseline.
# MoralStack modules use their own env vars (MORALSTACK_RISK_MODEL, MORALSTACK_CRITIC_MODEL, etc.).
# If set, overrides CLI --model for baseline. If unset or empty, uses gpt-4o.
# MORALSTACK_BENCHMARK_BASELINE_MODEL=gpt-4o
# Model for the judge (evaluation). If set, always used; otherwise same as generation model.
# When different from baseline/MoralStack model, the judge is independent.
# MORALSTACK_BENCHMARK_JUDGE_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# UI (moralstack-ui)
# -----------------------------------------------------------------------------
MORALSTACK_UI_PORT=8765
# Basic Auth (required when running moralstack-ui)
MORALSTACK_UI_USERNAME=
MORALSTACK_UI_PASSWORD=

# -----------------------------------------------------------------------------
# Constitution retrieval (optional overrides)
# -----------------------------------------------------------------------------
# Max number of parallel domain agents in ConstitutionStore and SDK/CLI factory.
# MORALSTACK_CONSTITUTION_MAX_PARALLEL_AGENTS=2
# Model for the DomainPrefilter LLM classifier (constitution_retriever.domain_prefilter).
# When unset, the prefilter inherits OPENAI_MODEL (today: gpt-4o). A small classifier
# like gpt-4o-mini is sufficient for the task and significantly reduces routing-stage
# latency. Validate first with scripts/compare_domain_prefilter_models.py.
# MORALSTACK_DOMAIN_PREFILTER_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Risk Estimator (optional overrides)
# -----------------------------------------------------------------------------
# See docs/modules/risk_estimator.md for full documentation of each variable.
# Model for the semantic judge (if set, overrides OPENAI_MODEL for risk only)
# MORALSTACK_RISK_MODEL=gpt-4o-mini
# Risk estimation always uses focused parallel estimators. Optional per-slot overrides below apply.
# If a slot is unset or empty, it inherits MORALSTACK_RISK_MODEL when set, else OPENAI_MODEL, else gpt-4o.
# MORALSTACK_RISK_INTENT_MODEL=gpt-4o
# MORALSTACK_RISK_SIGNALS_MODEL=gpt-4o
# MORALSTACK_RISK_OPERATIONAL_MODEL=gpt-4o
# MORALSTACK_RISK_LOW_THRESHOLD=0.25
# MORALSTACK_RISK_MEDIUM_THRESHOLD=0.65
# MORALSTACK_RISK_MAX_RETRIES=2
# MORALSTACK_RISK_MAX_TOKENS=512
# MORALSTACK_RISK_TEMPERATURE=0
# MORALSTACK_RISK_FALLBACK_SCORE=0.5
# MORALSTACK_RISK_FALLBACK_CONFIDENCE=0.3
# MORALSTACK_RISK_REQUIRE_DELIBERATION_ON_FALLBACK=true
# MORALSTACK_RISK_TOP_P=0.8
# MORALSTACK_RISK_TOP_K=10
# MORALSTACK_RISK_RULE_PREVIEW_LEN=200
# MORALSTACK_RISK_CRISIS_CLAMP_LOW=0.35
# MORALSTACK_RISK_CRISIS_CLAMP_HIGH=0.65
# MORALSTACK_RISK_CATEGORIZE_BENIGN_THRESHOLD=0.2
# MORALSTACK_RISK_CATEGORIZE_SENSITIVE_THRESHOLD=0.5
# MORALSTACK_RISK_CATEGORIZE_CLEARLY_HARMFUL_THRESHOLD=0.85

# -----------------------------------------------------------------------------
# Perspective (optional overrides)
# -----------------------------------------------------------------------------
# See docs/modules/perspectives.md for full documentation of each variable.
# Model for perspective ensemble (if set, overrides OPENAI_MODEL for perspectives only; used in run and benchmark)
# MORALSTACK_PERSPECTIVES_MODEL=gpt-4o-mini
# MORALSTACK_PERSPECTIVES_MAX_RETRIES=3
# MORALSTACK_PERSPECTIVES_MAX_TOKENS=512
# MORALSTACK_PERSPECTIVES_TEMPERATURE=0.1
# MORALSTACK_PERSPECTIVES_TOP_P=0.9
# MORALSTACK_PERSPECTIVES_PARALLEL_EVALUATION=false
# MORALSTACK_PERSPECTIVES_MAX_WORKERS=3
# MORALSTACK_PERSPECTIVES_TIMEOUT_SECONDS=60.0
# MORALSTACK_PERSPECTIVES_MAX_PERSPECTIVES=2
# MORALSTACK_PERSPECTIVES_CONSERVATIVE_ON_FAILURE=true
# MORALSTACK_PERSPECTIVES_ENABLE_CACHING=true

# -----------------------------------------------------------------------------
# Critic (optional overrides)
# -----------------------------------------------------------------------------
# See docs/modules/critic.md for full documentation of each variable.
# Model for constitutional critic (if set, overrides OPENAI_MODEL for critic only; used in run and benchmark)
# MORALSTACK_CRITIC_MODEL=gpt-4o
# MORALSTACK_CRITIC_MAX_RETRIES=2
# MORALSTACK_CRITIC_MAX_TOKENS=512
# MORALSTACK_CRITIC_TEMPERATURE=0
# MORALSTACK_CRITIC_TOP_P=0.9
# MORALSTACK_CRITIC_TOP_K_PRINCIPLES=15
# MORALSTACK_CRITIC_INCLUDE_EXAMPLES=false
# Chars of each principle rule the critic reads. Rules longer than this are cut
# mid-sentence: a carve-out placed at the end of a rule never reaches the judge.
# Longest rule shipped is 492 chars, so 512 disables truncation entirely at no
# extra cost (the window only caps, it does not pad). Default 180 = historical.
# MORALSTACK_CRITIC_MAX_RULE_LEN=250

# -----------------------------------------------------------------------------
# Simulator (optional overrides)
# -----------------------------------------------------------------------------
# See docs/modules/simulator.md for full documentation of each variable.
# Model for consequence simulator (if set, overrides OPENAI_MODEL for simulator only; used in run and benchmark)
# MORALSTACK_SIMULATOR_MODEL=gpt-4.1-nano
# MORALSTACK_SIMULATOR_MAX_RETRIES=3
# MORALSTACK_SIMULATOR_MAX_TOKENS=384
# MORALSTACK_SIMULATOR_TEMPERATURE=0.1
# MORALSTACK_SIMULATOR_TOP_P=0.95
# MORALSTACK_SIMULATOR_DEFAULT_NUM_SCENARIOS=3
# MORALSTACK_SIMULATOR_USE_SEEDED_GENERATION=false
# MORALSTACK_SIMULATOR_ENABLE_CACHING=true

# -----------------------------------------------------------------------------
# Hindsight (optional overrides)
# -----------------------------------------------------------------------------
# See docs/modules/hindsight.md for full documentation of each variable.
# Model for hindsight evaluator (if set, overrides OPENAI_MODEL for hindsight only; used in run and benchmark)
# MORALSTACK_HINDSIGHT_MODEL=gpt-4o-mini
# MORALSTACK_HINDSIGHT_MAX_RETRIES=3
# MORALSTACK_HINDSIGHT_MAX_TOKENS=768
# MORALSTACK_HINDSIGHT_TEMPERATURE=0.2
# MORALSTACK_HINDSIGHT_TOP_P=0.9
# MORALSTACK_HINDSIGHT_WEIGHT_SAFETY=0.5
# MORALSTACK_HINDSIGHT_WEIGHT_HELPFULNESS=0.3
# MORALSTACK_HINDSIGHT_WEIGHT_HONESTY=0.2
# MORALSTACK_HINDSIGHT_REFUSE_THRESHOLD=-0.7
# MORALSTACK_HINDSIGHT_REVISE_THRESHOLD=0.0
# MORALSTACK_HINDSIGHT_USE_BATCH_EVALUATION=true
# MORALSTACK_HINDSIGHT_ENABLE_CACHING=true

# -----------------------------------------------------------------------------
# Orchestrator (optional overrides)
# -----------------------------------------------------------------------------
# See docs/modules/orchestrator.md for full documentation of each variable.
# MORALSTACK_ORCHESTRATOR_MAX_DELIBERATION_CYCLES=2
# MORALSTACK_ORCHESTRATOR_RISK_LOW_THRESHOLD=0.3
# MORALSTACK_ORCHESTRATOR_RISK_MEDIUM_THRESHOLD=0.7
# MORALSTACK_ORCHESTRATOR_TIMEOUT_MS=600000
# MORALSTACK_ORCHESTRATOR_ENABLE_PERSPECTIVES=true
# MORALSTACK_ORCHESTRATOR_NUM_SIMULATIONS=3
# MORALSTACK_ORCHESTRATOR_MIN_HINDSIGHT_SCORE=0.8
# MORALSTACK_ORCHESTRATOR_MAX_CRITICAL_VIOLATIONS=0
# MORALSTACK_ORCHESTRATOR_EARLY_EXIT_HINDSIGHT_THRESHOLD=0.75
# MORALSTACK_ORCHESTRATOR_ENABLE_SIMULATION=true
# MORALSTACK_ORCHESTRATOR_ENABLE_HINDSIGHT=true
# MORALSTACK_ORCHESTRATOR_SAFE_RESPONSE_ON_ERROR=true
# MORALSTACK_ORCHESTRATOR_SKIP_OPTIONAL_MODULES_THRESHOLD=0.95
# MORALSTACK_ORCHESTRATOR_SOFT_TIMEOUT_THRESHOLD=0.90
# When true, critic/simulator/perspectives run in parallel; their LLM calls are persisted and visible in moralstack-ui.
# MORALSTACK_ORCHESTRATOR_PARALLEL_MODULE_CALLS=true
# MORALSTACK_ORCHESTRATOR_ENABLE_SIMULATOR_GATING=true
# Default true: hindsight only in final cycle; set to false to run hindsight every cycle
# MORALSTACK_ORCHESTRATOR_ENABLE_HINDSIGHT_GATING=true
# MORALSTACK_ORCHESTRATOR_SIMULATOR_GATE_SEMANTIC_HARM_THRESHOLD=0.4
# MORALSTACK_ORCHESTRATOR_SIMULATOR_GATE_DELTA_CHARS_THRESHOLD=100
# Conservative skip only if prior semantic_expected_harm is strictly below this (default 0.25).
# MORALSTACK_ORCHESTRATOR_SIMULATOR_GATE_SKIP_MAX_PRIOR_SEMANTIC_HARM=0.25
# MORALSTACK_ORCHESTRATOR_BORDERLINE_REFUSE_UPPER=0.95
# When true and PARALLEL_MODULE_CALLS=true, critic runs in parallel with sim+persp instead of gating them sequentially.
# Hard violations are still honoured (sim/persp results discarded). Saves ~3.5s per cycle.
# MORALSTACK_ORCHESTRATOR_PARALLEL_CRITIC_WITH_MODULES=true
# When true (default), each deliberation cycle picks critic_gated vs full_parallel from risk posture (execution only).
# Set to false to use only parallel_critic_with_modules for the static fork (legacy).
# MORALSTACK_ORCHESTRATOR_ENABLE_DYNAMIC_PARALLEL_SCHEDULER=true
# When true, risk estimation and draft generation run in parallel (speculative overlap). Saves ~4s on deliberative path.
# MORALSTACK_ORCHESTRATOR_ENABLE_SPECULATIVE_GENERATION=true
# Cycle-1 early convergence: conservative gate to skip cycle 2 when all modules agree at cycle 1.
# These thresholds control when the system can stop after 1 deliberation cycle instead of always running 2.
# Lower values = more queries converge early (reduced latency); higher values = more conservative (always 2 cycles).
# Only applies when max_deliberation_cycles >= 2 and query enters DELIBERATIVE_PATH.
# MORALSTACK_ORCHESTRATOR_CYCLE1_EARLY_CONVERGENCE_MIN_WEIGHTED_APPROVAL=0.78
# MORALSTACK_ORCHESTRATOR_CYCLE1_EARLY_CONVERGENCE_MAX_SEMANTIC_HARM=0.35
# MORALSTACK_ORCHESTRATOR_CYCLE1_EARLY_CONVERGENCE_MIN_PER_PERSPECTIVE_APPROVAL=0.70

# Opt-in: when true, a clearly benign, non-operational informational request in a
# sensitive overlay (e.g. financial, legal) returns NORMAL_COMPLETE instead of being
# floored to SAFE_COMPLETE. Any risk signal (ambiguity/dual-use, requested
# instructions, intent-to-harm, operational intent) keeps SAFE_COMPLETE.
# Default false preserves the current regulated -> SAFE_COMPLETE behavior.
# MORALSTACK_ORCHESTRATOR_REGULATED_INFORMATIONAL_NORMAL_COMPLETE=true

# -----------------------------------------------------------------------------
# OpenAI-compatible bridge server (scripts/openai_compatible_server.py)
# -----------------------------------------------------------------------------
# Host and port for the standalone OpenAI-compatible FastAPI bridge.
# Used to expose MoralStack as an OpenAI-compatible endpoint (e.g. for COMPL-AI).
# MORALSTACK_OPENAI_COMPATIBLE_API_HOST=localhost
# MORALSTACK_OPENAI_COMPATIBLE_API_PORT=8787
# Max concurrent in-flight requests accepted by the bridge before returning overload (HTTP 503).
# MORALSTACK_OPENAI_COMPATIBLE_MAX_INFLIGHT=8
# Retry-After seconds for temporary overload responses (HTTP 503).
# MORALSTACK_OPENAI_COMPATIBLE_RETRY_AFTER_SECONDS=10

# -----------------------------------------------------------------------------
# Developer Contract Compliance Layer (DCCL)
# -----------------------------------------------------------------------------
# Enable the DCCL. When enabled, requests with a developer contract are
# evaluated by the DCCL before the standard governance pipeline.
# Default: true
# MORALSTACK_DCCL_ENABLED=true

# Evaluation path preference.
# - structured: only structured_rules are evaluated (fast path, deterministic).
#   Contracts with only raw_text return NO_MATCH.
# - llm: only raw_text is evaluated via LLM (slow path, flexible).
#   structured_rules are ignored.
# - hybrid: structured_rules tried first; falls back to LLM if no match.
# Default: hybrid
# MORALSTACK_DCCL_EVALUATION_PATH=hybrid

# Model used by the LLM path. Recommended: gpt-4o for accuracy.
# gpt-4o-mini is cheaper but may be less reliable on adversarial contracts.
# Default: gpt-4o
MORALSTACK_DCCL_LLM_MODEL=gpt-4o
MORALSTACK_DCCL_SAFETY_OVERRIDE_MODEL=gpt-4o-mini

# Timeout for the LLM path in milliseconds.
# On timeout, DCCL returns NO_MATCH (failsafe to standard pipeline).
# Default: 5000
# MORALSTACK_DCCL_LLM_TIMEOUT_MS=5000

# Max tokens for the LLM path response.
# Default: 512
# MORALSTACK_DCCL_LLM_MAX_TOKENS=512

# Minimum confidence threshold for MATCH verdict.
# Below this threshold, DCCL emits NO_MATCH even if the LLM suggests a match.
# Higher values are more conservative (more requests go to standard pipeline).
# Default: 0.85
MORALSTACK_DCCL_CONFIDENCE_THRESHOLD=0.85

# Maximum number of structured_rules a single contract can declare.
# Contracts exceeding this limit fail to load.
# Default: 100
# MORALSTACK_DCCL_MAX_RULES_PER_CONTRACT=100

# Safety Override strict mode.
# When true, any rule whose action_payload classifies as safety-restricted
# is rejected at contract loading time and DCCL emits SAFETY_OVERRIDE at runtime
# if encountered. When false, only runtime check applies (rules load anyway).
# Default: true (recommended for production)
# MORALSTACK_DCCL_SAFETY_OVERRIDE_STRICT=true

# -----------------------------------------------------------------------------
# Tracing & Debug
# -----------------------------------------------------------------------------
# Set to 1 or true for verbose output
# MORALSTACK_VERBOSE=
