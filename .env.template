# Perspectives
# -----------------------------------------------------------------------------
# See docs/modules/perspectives.md.

# Perspective ensemble model.
# Type: model id. (code default: follows primary model (OPENAI_MODEL) = gpt-4o)
MORALSTACK_PERSPECTIVES_MODEL=gpt-4o-mini

# Perspective attempts per call.
